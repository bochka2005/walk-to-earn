# ═══════════════════════════════════════════════════════════════
# Файл: .env.example
# Назначение: Шаблон для файла .env (переменные окружения).
# Что происходит: Скопируй этот файл в .env и впиши свой
# реальный BOT_TOKEN от BotFather. Сам .env в git не попадает
# (спрятан в .gitignore), чтобы токен не утёк.
# ═══════════════════════════════════════════════════════════════
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11  # Сюда вставить токен от @BotFather
DATABASE_URL=postgresql://user:password@localhost:5432/walktoearn  # Раскомментировать для своей БД
